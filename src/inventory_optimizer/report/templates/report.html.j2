<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Inventory optimization report - {{ as_of }}</title>
<style>
:root{--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;--bg:#f8fafc;--card:#fff}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{background:#0f172a;color:#fff;padding:28px 24px}
header h1{margin:0 0 4px;font-size:24px}
header p{margin:0;color:#cbd5e1}
main{max-width:1180px;margin:0 auto;padding:24px}
h2{font-size:18px;margin:32px 0 12px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.card .label{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.04em}
.card .value{font-size:22px;font-weight:650;margin-top:4px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px}
.badge{display:inline-block;padding:2px 10px;border-radius:999px;font-size:12px;font-weight:600}
.badge.DEAD{background:#e2e8f0;color:#334155}
.badge.CRITICAL{background:#fee2e2;color:#b91c1c}
.badge.REORDER{background:#fef3c7;color:#b45309}
.badge.OVERSTOCK{background:#e0e7ff;color:#4338ca}
.badge.OK{background:#dcfce7;color:#15803d}
.statuses{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
table{border-collapse:collapse;width:100%}
th,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
th{background:#f1f5f9;font-size:12px;text-transform:uppercase;letter-spacing:.03em;color:var(--muted)}
.scroll{overflow-x:auto;background:var(--card);border:1px solid var(--line);border-radius:10px}
.heat td,.heat th{text-align:center;padding:12px}
.warn{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:10px 16px;color:#92400e}
footer{color:var(--muted);text-align:center;padding:24px;font-size:13px}
</style>
</head>
<body>
<header><h1>Inventory optimization report</h1><p>As of {{ as_of }} &middot; {{ subtitle }}</p></header>
<main>
<section class="cards">
{% for label, value in kpis %}<div class="card"><div class="label">{{ label }}</div><div class="value">{{ value }}</div></div>
{% endfor %}</section>
<div class="statuses">{% for name, n in status_counts.items() %}<span class="badge {{ name }}">{{ name }}: {{ n }}</span>{% endfor %}</div>

<h2>ABC x XYZ matrix (SKU counts)</h2>
<div class="panel"><table class="heat"><tr><th>ABC \ XYZ</th><th>X</th><th>Y</th><th>Z</th></tr>
{% for row in heat %}<tr><th>{{ row.label }}</th>{% for c in row.cells %}<td style="{{ c.style }}">{{ c.n }}</td>{% endfor %}</tr>
{% endfor %}</table></div>

<h2>Consumption value</h2>
<div class="grid"><div class="panel">{{ share_chart|safe }}</div><div class="panel">{{ top_chart|safe }}</div></div>

{% macro table(rows) %}<div class="scroll"><table><tr>{% for h in headers %}<th>{{ h }}</th>{% endfor %}</tr>
{% for row in rows %}<tr>{% for cell in row %}{% if loop.index0 == status_index %}<td><span class="badge {{ cell }}">{{ cell }}</span></td>{% else %}<td>{{ cell }}</td>{% endif %}{% endfor %}</tr>
{% endfor %}</table></div>{% endmacro %}

<h2>Most urgent SKUs</h2>
{% if urgent %}{{ table(urgent) }}{% else %}<p>No SKU needs ordering.</p>{% endif %}

<h2>Full reorder plan</h2>
{% if plan %}{{ table(plan) }}{% else %}<p>No SKU needs ordering.</p>{% endif %}

{% if warnings %}<h2>Warnings</h2><div class="warn"><ul>{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>{% endif %}
</main>
<footer>Generated by inventory-optimizer</footer>
</body>
</html>
